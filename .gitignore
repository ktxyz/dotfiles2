# gitignore for ~/.dotfiles

# untracked per-machine / personal overlays (symlinked into ~, never pushed)
.zshrc.local
.gitconfig.local

# generated package reports
packages/.generated/

# stow bookkeeping
*.orig
.org/

# pi runtime artifacts that live next to stowed files
pi/.pi/agent/auth.json
pi/.pi/agent/trust.json
